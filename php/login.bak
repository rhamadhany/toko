<?php

session_start();
header("Content-Type: application/json");
header("Access-Control_Allow_Origin: *");

require_once 'connect.php';

if ($_SERVER['REQUEST_METHOD'] === 'POST'){
$email = mysqli_real_escape_string($koneksi, $_POST['email']);
$password = mysqli_real_escape_string($koneksi, $_POST['password']);
$query = 'SELECT *  FROM user WHERE email = ?';
$stmt = mysqli_prepare($koneksi, $query);
mysqli_stmt_bind_param($stmt, "s", $email);
mysqli_stmt_execute($stmt);
$result = mysqli_stmt_get_result($stmt);
if ($user = mysqli_fetch_assoc($result)) {
    if (password_verify($password, $user['password'])){
        $_SESSION['username'] = $username;
        $_SESSION['user_id'] = $$user['id'];
        echo json_encode(['status' => 'success', 'message' => 'Login berhasil', 'username' => $user['usernamea']]);
    } else {
        echo json_encode(['status' => 'error', 'message' => 'Password yang dimasukkan tidak benar!']);

    } 
}
else {
    echo json_encode(['status' => 'error', 'message' => 'Email tidak terdaftar!']);
}
}
?>